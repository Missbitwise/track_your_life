# PostgreSQL connection string (preferred; supports SSL query parameters)
DATABASE_URL=postgresql://username:password@localhost:5432/productivity_db

# Optional direct connection URL for tools that need a non-pooled connection
DIRECT_URL=postgresql://username:password@localhost:5432/productivity_db

# Optional application port
PORT=3000

# Use two different unique random secrets, each at least 32 characters. Never commit real values.
JWT_ACCESS_SECRET=replace-this-with-a-random-access-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-this-with-a-random-refresh-secret-of-at-least-32-characters

# Google Gemini API (keep the real key in .env or your deployment secret store)
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

{
"name": "productivity_backend",
"version": "1.0.0",
"description": "Productivity application backend",
"main": "dist/server.js",
"type": "module",
"scripts": {
"dev": "tsx watch src/server.ts",
"build": "tsc",
"start": "node dist/server.js",
"migration:up": "tsx ./node_modules/typeorm/cli.js migration:run -d src/config/database.ts",
"migration:down": "tsx ./node_modules/typeorm/cli.js migration:revert -d src/config/database.ts",
"migration:create": "tsx ./node_modules/typeorm/cli.js migration:generate -d src/config/database.ts src/migrations/GeneratedMigration",
"migration:show": "tsx ./node_modules/typeorm/cli.js migration:show -d src/config/database.ts"
},
"keywords": [],
"author": "",
"license": "ISC",
"dependencies": {
"@google/genai": "^3.6.1",
"bcrypt": "^6.0.0",
"bullmq": "^6.6.0",
"cors": "^2.8.6",
"dotenv": "^18.0.9",
"express": "^5.3.0",
"express-rate-limit": "^8.7.3",
"google-auth-library": "^10.9.1",
"helmet": "^8.3.0",
"ioredis": "^5.0.4",
"jsonwebtoken": "^9.0.3",
"pg": "^8.23.1",
"pino": "^10.4.0",
"pino-http": "^11.0.0",
"reflect-metadata": "^0.2.2",
"ws": "^8.22.1",
"zod": "^4.6.7",
"typeorm": "^0.3.31"
},
"devDependencies": {
"@types/bcrypt": "^6.0.0",
"@types/cors": "^2.8.19",
"@types/express": "^5.0.6",
"@types/jsonwebtoken": "^9.0.10",
"@types/node": "^26.6.6",
"@types/pg": "^8.23.1",
"@types/ws": "^8.18.2",
"tsx": "^4.23.15",
"typescript": "^7.0.2"
}
}